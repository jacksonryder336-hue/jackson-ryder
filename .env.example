# =====================================================================
#  JACKSON RYDER — ENVIRONMENT SETTINGS
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env to a public repository.
# =====================================================================

# ---- EMAIL (contact form → Gmail) ------------------------------------

# OPTION 1 (simplest): Gmail via an App Password
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (remove spaces).
SMTP_USER=jacksoonryder336@gmail.com
SMTP_PASS=your-16-character-app-password

# (Optional overrides — defaults are correct for Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# OPTION 2: Resend (transactional email service) — takes priority if set
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where enquiries are delivered (defaults to your Gmail)
# MAIL_TO=jacksoonryder336@gmail.com

# ---- ADMIN DASHBOARD --------------------------------------------------
# Login at https://yoursite.com/admin with these credentials.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: a secret used to sign login sessions. Set a long random string
# in production so logins survive server restarts.
# SECRET=some-long-random-string
