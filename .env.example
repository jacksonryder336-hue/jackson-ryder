# =====================================================================
#  JACKSON RYDER — ENVIRONMENT SETTINGS
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env to a public repository.
# =====================================================================

# ---- DATABASE (Neon — free hosted PostgreSQL) ------------------------
# This is what makes your admin changes (songs, portfolios, bio) PERMANENT.
# 1. Create a free account at https://neon.tech
# 2. Create a project
# 3. Copy the "connection string" (starts with postgresql://)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- EMAIL (contact form → Gmail) ------------------------------------

# OPTION 1 (simplest): Gmail via an App Password
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
SMTP_USER=jacksonryder336@gmail.com
SMTP_PASS=your-16-character-app-password

# OPTION 2: Resend (transactional email service) — takes priority if set
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where enquiries are delivered (defaults to your Gmail)
# MAIL_TO=jacksonryder336@gmail.com

# ---- ADMIN DASHBOARD --------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: a secret used to sign login sessions. Set a long random string.
# SECRET=some-long-random-string
